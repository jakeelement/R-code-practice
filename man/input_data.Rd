\name{input_data}
\alias{input_data}
\title{Launch a data-entry Shiny app}
\usage{
input_data()
}
\value{
Invisibly returns \code{NULL} after the app exits.
}
\description{
Opens an interactive Shiny app with fields for Date, Trip, Captain,
and Measurement. Submitted rows are displayed in a table.
}
